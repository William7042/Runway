# Copy to .env — never commit real keys.

# Grok / xAI (research agent + verifier)
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Person C approval queue
APPROVAL_QUEUE_URL=http://localhost:8000

# Person A / True Markets (money layer only — agent layer must NOT use these)
# TM_KEY_FILE=
# TM_ENV=prod

# Safety: money-moving functions return without signing/sending when set
DRY_RUN=1

RUNWAY_DATA=data/proposals

# Person A money layer
TM_ENV=prod
TM_KEY_FILE=./truemarkets-org-api-key-REPLACE.json
# Separate trading signer if the API credential does not contain signing fields.
TM_SIGNER_KEY_FILE=./truemarkets-test-signer-key-test.json
DRY_RUN=1
RUNWAY_QUEUE_URL=http://localhost:8000
RUNWAY_MODE=stub
RUNWAY_MAX_PAYMENT_USD=1
RUNWAY_MAX_IMPACT_BPS=100
RUNWAY_MAX_DRIFT_BPS=200
RUNWAY_PAYMENT_FEE_USD=1
